         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Seismology: Seismicity and tectonics; Seismology: Earthquake interaction, forecasting, and prediction; Seismology: Earthquake source observations</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">A new estimation of the decay of aftershock density with distance to the mainshock</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
